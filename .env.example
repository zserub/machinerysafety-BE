# Machinery Safety backend - example configuration
# Copy to .env and adjust. Values below suit local development only.

# --- Server -------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s

# --- Database (PostgreSQL) -------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=machinery_safety
DB_USER=postgres
DB_PASSWORD=password
DB_SCHEMA=eng
DB_SSL_MODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# PostgreSQL container (docker-compose.dev.yml)
POSTGRES_DB=machinery_safety
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# --- Migrations ------------------------------------------------------------------
# Create/upgrade tables on startup
RUN_MIGRATIONS=true
# MIGRATIONS_PATH=file://migrations
# Dev only: demo users and entries applied after migrations (password: "password")
# SEEDS_PATH=file://seeds

# --- First admin account ---------------------------------------------------------
# Created on startup only when the database has no users (min. 8 characters)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# --- Photo storage (MinIO) -------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY_ID=minioadmin
MINIO_SECRET_ACCESS_KEY=password
MINIO_BUCKET=photos
MINIO_USE_SSL=false

# MinIO container (docker-compose.dev.yml)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=password

# --- Sessions --------------------------------------------------------------------
# Required. 32-byte base64 key, generate with: openssl rand -base64 32
SESSION_KEY=
SESSION_NAME=machinery_session
SESSION_MAX_AGE=86400
# true when the app is served over HTTPS
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# --- CORS ------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Security --------------------------------------------------------------------
BCRYPT_COST=10

# --- Logging ---------------------------------------------------------------------
# debug, info, warn, error
LOG_LEVEL=info
# json or text
LOG_FORMAT=json
LOG_FILE_PATH=

# --- Metabase (statistics) -------------------------------------------------------
# Address the backend uses to reach Metabase
METABASE_URL=http://localhost:3000
# Address browsers use to open Metabase (defaults to METABASE_URL)
METABASE_PUBLIC_URL=
METABASE_API_KEY=
# For JWT signed embeds (optional)
METABASE_SECRET_KEY=
# Create the analytics dashboard on startup (needs METABASE_API_KEY)
RUN_METABASE_SETUP=false
# ID of the machinery_safety database inside Metabase
METABASE_DATABASE_ID=3
